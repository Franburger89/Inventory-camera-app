# Shared PIN staff enter on the phone. At least 4 characters.
STAFF_PIN=change-me

# Bearer token for the assistant's admin API. At least 8 characters.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=change-me-admin-token

# Directory for session folders. On Railway this must be the volume mount.
DATA_DIR=./data

# Optional. Comma-separated. Defaults are the household locations and people.
# LOCATIONS=32 LRV,Via Borgonuovo,Maison Senato Capsule,St Moritz,20 Greene NYC,Travel Pack
# PEOPLE=Eli,Anna,Shared

# Railway sets PORT. Locally the default is 3000.
# PORT=3000
